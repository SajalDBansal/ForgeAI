{
  "name": "forgeAI",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev worker:audit worker:cleanup worker:github worker:notification --concurrency=20",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"apps/{api-server,agent-worker,orchestrator,ws-server,web}/**/*.{ts,tsx,js,mjs,json,css}\" \"packages/**/*.{ts,tsx,js,mjs,json,css}\" \"*.{json,ts}\"",
    "format": "prettier --write \"apps/{api-server,agent-worker,orchestrator,ws-server,web}/**/*.{ts,tsx,js,mjs,json,css}\" \"packages/**/*.{ts,tsx,js,mjs,json,css}\" \"*.{json,ts}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:seed": "turbo run db:seed",
    "db:studio": "bun run --cwd packages/database studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.0",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "dompurify": "3.4.16",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
