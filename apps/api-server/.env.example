PORT=3002

DATABASE_URL="postgresql://starter:starter@localhost:5432/turbo_starter?schema=public"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3002"

CLIENT_ORIGIN="http://localhost:3000"
# Optional public base for preview proxy links. In production, point this at a cookieless
# preview host routed to api-server; locally it can stay on BETTER_AUTH_URL.
# PREVIEW_PUBLIC_ORIGIN="http://localhost:3002"
# Only enable when api-server is behind a trusted reverse proxy/load balancer that owns
# X-Forwarded-* headers. Local/dev default is false.
TRUST_PROXY="false"

ORCHESTRATOR_URL="http://localhost:3004"
# Sent with every orchestrator call; the same value as apps/orchestrator/.env (audit C-1).
ORCHESTRATOR_TOKEN="CHANGE_ME"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

RESEND_API_KEY=""
EMAIL_FROM=""

CONNECTION_ENCRYPTION_KEY=""
CONNECTION_ENCRYPTION_KEY_ID="current"
# CONNECTION_PREVIOUS_ENCRYPTION_KEYS="old=old-secret"
# Encrypts Team chat messages at rest — its own key, never the one above.
# Generate with: openssl rand -hex 32. Rotate by keeping the old key below until re-encryption is done.
TEAM_CHAT_ENCRYPTION_KEY=""
TEAM_CHAT_ENCRYPTION_KEY_ID="current"
# TEAM_CHAT_PREVIOUS_ENCRYPTION_KEYS="old=old-secret"
# Encrypts project secrets (the env vars users save for their apps) — also its own key.
# Generate with: openssl rand -hex 32. Rotate by keeping the old key below until re-encryption is done.
PROJECT_SECRETS_ENCRYPTION_KEY=""
PROJECT_SECRETS_ENCRYPTION_KEY_ID="current"
# PROJECT_SECRETS_PREVIOUS_ENCRYPTION_KEYS="old=old-secret"
CONNECTION_APP_SLUG=""

GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
# The GitHub App's OAuth client (App settings → General → Client ID / client secret),
# used to create each project's repository in the owner's account. Set the App's
# "Callback URL" to <api>/api/v1/connections/github/callback.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

VERCEL_CLIENT_ID=""
VERCEL_CLIENT_SECRET=""

SUPABASE_CLIENT_ID=""
SUPABASE_CLIENT_SECRET=""

REDIS_URL="redis://localhost:6379"
WS_TICKET_SECRET=""

R2_BUCKET_NAME=""
R2_BUCKET_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Where commits live in R2. Must match apps/orchestrator's value.
R2_SNAPSHOT_FOLDER_NAME="snapshots"

# Optional tuning: these are the defaults, leave a line out to use them.
# Cache lifetimes (seconds).
CONNECTION_CACHE_TTL_SECONDS="45"
METADATA_CACHE_TTL_SECONDS="20"
TEMPLATE_CACHE_TTL_SECONDS="300"
# Idempotency-Key: how long a finished request is replayed (seconds), and how long a
# running one holds its key (ms). Keep the second longer than the slowest wrapped call.
IDEMPOTENCY_RESULT_TTL_SECONDS="3600"
IDEMPOTENCY_RUNNING_TTL_MS="30000"
# Connect-flow state, GitHub head check and template download link lifetimes.
CONNECT_STATE_TTL_MS="600000"
GITHUB_HEAD_CHECK_TTL_MS="60000"
TEMPLATE_DOWNLOAD_URL_TTL_SECONDS="300"

# Set to "production" in deployments (the Docker image already does). It switches on the shutdown drain below;
# leave it unset locally.
# NODE_ENV=production

# On SIGTERM, seconds to keep serving while /readyz fails, so the load balancer moves away first.
# Defaults to 5 when NODE_ENV=production, 0 otherwise (so local restarts stay instant).
# SHUTDOWN_DRAIN_SECONDS=5

# Connections to the orchestrator per api-server copy (sandbox opens hold one for up to a minute).
# ORCHESTRATOR_POOL_CONNECTIONS=64

# Which E2B plan the account is on: hobby (default), pro, pro-600, pro-1100, or custom. It sets
# how many sandboxes can run at once, how fast they can be created and how long they may live.
# Must be the same in api-server and the orchestrator.
SANDBOX_PLAN="hobby"
# The plan's numbers, shown here with Hobby's values. Leave them commented: SANDBOX_PLAN supplies them,
# and changing it (e.g. to "pro") changes them all. Uncommenting one pins it, even after an upgrade.
# Only SANDBOX_PLAN="custom" needs all six set.
# SANDBOX_PLAN_MAX_CONCURRENT="20"       # sandboxes at once on the whole account
# SANDBOX_PLAN_CREATES_PER_SECOND="1"    # new sandboxes per second
# SANDBOX_PLAN_LIFETIME_MINUTES="60"     # E2B ends a sandbox this long after it was created
# SANDBOX_PLAN_VCPU="8"                  # most vCPU one sandbox may have
# SANDBOX_PLAN_MEMORY_MB="8192"          # most memory one sandbox may have
# SANDBOX_PLAN_DISK_MB="10240"           # most disk one sandbox may have
# SANDBOX_PLAN_RESERVE="2"               # slots kept free for recycling and restarts (usable = 20 - 2 = 18)

# Sandboxes one workspace owner may have running at once; their next new one is refused with a
# message. Default 2. Raise it in your local .env while developing if 2 is tight.
# OWNER_MAX_SANDBOXES=2

# Model spend budgets in millionths of a dollar. 0 = off.
# AGENT_DAILY_BUDGET_MICROS=0
# AGENT_OWNER_MONTHLY_BUDGET_MICROS=0

# The knowledge graph service (apps/rag-service, work plan Q5). Optional: unset, deleting a
# project skips removing its graph. The secret is the same value as apps/rag-service/.env.
RAG_SERVICE_URL="http://127.0.0.1:3005"
RAG_SERVICE_SECRET=""

# Guards /api/v1/internal, which only ForgeAI's own services call (the agent worker, I5b).
# The same value as apps/agent-worker/.env. Unset: every internal request is refused.
INTERNAL_API_TOKEN=""
## Background workers (separate processes; PORT remains the API port).
# WORKER_PORT overrides the per-role defaults: audit=3007, cleanup=3008, github=3009, notification=3010.
# JOB_CONCURRENCY overrides per-role defaults: audit=8, others=2.
JOB_POLL_MS=2000
JOB_SHUTDOWN_SECONDS=30
AUDIT_RETENTION_DAYS=90

