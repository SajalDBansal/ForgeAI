# Public: copied into the browser bundle at build time, so never put a secret here.
# Read in one place, apps/web/lib/env.ts.
NEXT_PUBLIC_AUTH_URL="http://localhost:3002"
# Optional public preview origin. Use the same value as PREVIEW_PUBLIC_ORIGIN on api-server.
# Locally this may stay on the API origin.
# NEXT_PUBLIC_PREVIEW_URL="http://localhost:3002"
NEXT_PUBLIC_WS_URL="ws://localhost:3003"

# CSP is enforced by default. Set to 1 only while investigating a policy change.
# CSP_REPORT_ONLY=1
