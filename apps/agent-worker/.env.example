# apps/agent-worker (work plan I5). It takes runs off the "agent-runs" queue and works them.
# Sandbox work goes to the orchestrator over HTTP; events go out on Redis (docs/10 §4.4).

PORT=3006

# The same database and Redis as api-server.
DATABASE_URL="postgresql://starter:starter@localhost:5432/turbo_starter?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# The model (packages/agent): provider, key and models are settings, not code.
AGENT_PROVIDER=openai
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL_CODE=gpt-5-nano
AGENT_MODEL_FAST=gpt-4.1-nano
# Optional last try when the main model is rate-limited before it writes anything.
AGENT_MODEL_FALLBACK=
AGENT_THINKING=low

# The orchestrator (all sandbox work) and the knowledge graph service. Same values as api-server's.
ORCHESTRATOR_URL="http://localhost:3004"
ORCHESTRATOR_TOKEN="CHANGE_ME"
RAG_SERVICE_URL="http://127.0.0.1:3005"
RAG_SERVICE_SECRET=""

# Tuning (defaults shown).
# WORKER_CONCURRENCY=4
# RUN_LOCK_TTL_MS=60000
# TURN_WAIT_MS=2000
# AGENT_MAX_TURNS=40
# AGENT_MAX_TOKENS=90000
# AGENT_RUN_TIMEOUT_MS=600000
# AGENT_RUN_COST_LIMIT_MICROS=0
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_SUMMARY_MODEL=gpt-4.1-nano
# SHUTDOWN_GRACE_SECONDS=30

# api-server, to open a run's sandbox the way a tab does (I5b, option A).
INTERNAL_API_URL="http://127.0.0.1:3002"
INTERNAL_API_TOKEN=""
