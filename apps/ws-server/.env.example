PORT=3003

# Must match api-server's CLIENT_ORIGIN — used to reject cross-origin browser connections.
CLIENT_ORIGIN="http://localhost:3000"

# Same Redis instance api-server publishes project events to.
REDIS_URL="redis://localhost:6379"

# Must be the exact same value as api-server's WS_TICKET_SECRET.
WS_TICKET_SECRET=""

# Socket.IO's own ping interval/timeout (ms) for detecting dead connections.
WS_PING_INTERVAL_MS="25000"
WS_PING_TIMEOUT_MS="20000"
# The longest a WebSocket stays open before it reconnects with a fresh ticket (audit M-10).
WS_MAX_CONNECTION_MINUTES="15"

# Set to "production" in deployments (the Docker image already does). It switches on the shutdown drain below;
# leave it unset locally.
# NODE_ENV=production

# On SIGTERM, seconds over which open sockets are disconnected, so tabs don't all reconnect at once.
# Defaults to 10 when NODE_ENV=production, 0 otherwise (so local restarts stay instant).
# SHUTDOWN_DRAIN_SECONDS=10
