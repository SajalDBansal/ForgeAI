# .env.example
# ============
# Copy this file to `.env` and fill in the real values.
#
#     cp .env.example .env          (Git Bash / macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#
# `.env` is listed in .gitignore, so your real keys never get committed.
# This example file has no secrets in it, so it is safe to commit.


# --- Neo4j ---------------------------------------------------------------
# The address of your Neo4j. In ForgeAI it's the `neo4j` service in infra/docker-compose.dev.yml,
# and the password below is that file's default (NEO4J_PASSWORD overrides both).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forgeai-dev-password


# --- OpenAI (ChatGPT) ----------------------------------------------------
# Used for the embeddings and the folder summaries (the service never writes answers).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: an OpenAI-compatible endpoint instead of OpenAI (then its key above and its model names below).
#   OpenRouter: https://openrouter.ai/api/v1     Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# The model that turns code into vectors.
#   text-embedding-3-small  1536 dimensions, cheap  (recommended)
#   text-embedding-3-large  3072 dimensions, better and pricier
EMBEDDING_MODEL=text-embedding-3-small

# MUST match the model above. Changing it later means dropping and rebuilding
# the Neo4j vector index, so pick one and stay with it.
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
EMBEDDING_DIM=1536

# The model that writes the folder summaries at index time.
CHAT_MODEL=gpt-4.1-nano


# --- Optional tuning -----------------------------------------------------
# Everything below has a sensible default in graph_rag/config.py.
# Uncomment a line only if you actually want to change it.

# How many code blocks the vector search returns as starting points.
# DEFAULT_TOP_K=5

# How far to walk out from each starting point (1 or 2).
# DEFAULT_HOPS=1

# Rough size limit of the code pasted into the prompt, in characters.
# MAX_CONTEXT_CHARS=60000

# Skip any single CODE file larger than this many bytes.
# MAX_FILE_SIZE_BYTES=1000000

# Skip any DOCUMENT or CONFIG file larger than this. Generous by default so
# that large schemas and reference data are still indexed; lower it if you
# have big machine-generated exports you would rather not pay to embed.
# MAX_DOC_FILE_SIZE_BYTES=1000000

# How large one chunk of a heading-less file may get before it is split.
# MAX_DOC_CHUNK_CHARS=4000

# Extra folder names to exclude from indexing, comma separated. node_modules,
# venv, dist, build, vendor, coverage, .git and friends are already excluded
# by default - this is for project-specific ones.
# EXTRA_IGNORED_DIRECTORIES=data,seeds,dumps,legacy

# How many documentation sections to retrieve alongside the code (0 = none).
# DEFAULT_DOC_TOP_K=3

# --- The HTTP API (graph-rag-serve, ForgeAI work plan Q4) -----------------
# Every request must send this in the `x-rag-secret` header; the API refuses to
# start without one. The agent worker and api-server get the same value.
RAG_SERVICE_SECRET=
# Where it listens. Localhost: it is an internal service.
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=3005

# Exact HTTP origins the RAG API may download source archives from, comma separated.
# In ForgeAI this should include the R2 endpoint origin used by orchestrator signed URLs.
# Example: RAG_SOURCE_ALLOWED_ORIGINS=https://<account>.r2.cloudflarestorage.com
RAG_SOURCE_ALLOWED_ORIGINS=
