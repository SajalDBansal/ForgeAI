{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "cli": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "inquirer": "14.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.4.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
