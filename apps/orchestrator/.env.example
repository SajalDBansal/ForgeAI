PORT=3004
# Shared with api-server, the only caller allowed (audit C-1) — the same value goes in
# apps/api-server/.env. At least 32 characters: openssl rand -hex 32
ORCHESTRATOR_TOKEN="CHANGE_ME"
REDIS_URL="redis://localhost:6379"

# This orchestrator's name and its own sandbox limits (capacity doc §4). The plan's limit
# (SANDBOX_PLAN below) is usually the one that bites first; these matter with several orchestrators.
# ORCHESTRATOR_ID="orchestrator-0"
# ORCHESTRATOR_TARGET_SANDBOXES="80"
# ORCHESTRATOR_MAX_SANDBOXES="100"
# When overloaded for 30 s (event-loop lag or heap use above these), the orchestrator gives new
# projects "busy" until it recovers; existing projects keep working.
# ORCHESTRATOR_MAX_EVENT_LOOP_LAG_MS="200"
# ORCHESTRATOR_MAX_HEAP_PERCENT="80"

# Which sandbox provider runs the sandboxes. Only "e2b" exists today (the default).
# SANDBOX_PROVIDER="e2b"
E2B_API_KEY=""

# Which E2B plan the account is on: hobby (default), pro, pro-600, pro-1100, or custom. It sets
# how many sandboxes can run at once, how fast they can be created and how long they may live.
# Must be the same in api-server and the orchestrator.
SANDBOX_PLAN="hobby"
# The plan's numbers, shown here with Hobby's values. Leave them commented: SANDBOX_PLAN supplies them,
# and changing it (e.g. to "pro") changes them all. Uncommenting one pins it, even after an upgrade.
# Only SANDBOX_PLAN="custom" needs all six set.
# SANDBOX_PLAN_MAX_CONCURRENT="20"       # sandboxes at once on the whole account
# SANDBOX_PLAN_CREATES_PER_SECOND="1"    # new sandboxes per second
# SANDBOX_PLAN_LIFETIME_MINUTES="60"     # E2B ends a sandbox this long after it was created
# SANDBOX_PLAN_VCPU="8"                  # most vCPU one sandbox may have
# SANDBOX_PLAN_MEMORY_MB="8192"          # most memory one sandbox may have
# SANDBOX_PLAN_DISK_MB="10240"           # most disk one sandbox may have
# SANDBOX_PLAN_RESERVE="2"               # slots kept free for recycling and restarts (usable = 20 - 2 = 18)

# Which environment this orchestrator's sandboxes belong to. It only adopts, reattaches to and
# reaps sandboxes with the same value, so environments sharing an E2B account never touch each
# other's. Required in production (staging, production); locally it defaults to local-<computer>.
# SANDBOX_ENVIRONMENT="staging"

SANDBOX_IDLE_TIMEOUT_MINUTES="30"

# How long a dev server runs on after the last person closes the project.
# Deliberately not 0: a page refresh empties presence for a second or two.
DEV_SERVER_UNWATCHED_GRACE_SECONDS="90"

# When the reaper shuts a sandbox down. Its work is snapshotted to R2 first, and
# the pod is kept if that snapshot does not verify.
SANDBOX_UNWATCHED_REAP_MINUTES="10"   # nobody connected at all
SANDBOX_IDLE_REAP_MINUTES="45"        # tab open, nothing happening
SANDBOX_IDLE_WARNING_MINUTES="5"      # how long before that the tab is warned
# As the plan fills up, idle sandboxes are shut down sooner (work is still saved first, and an
# open tab still gets its warning). Above HIGH % of the usable slots, then above CRITICAL %:
# SANDBOX_PRESSURE_HIGH_PERCENT="70"
# SANDBOX_PRESSURE_HIGH_UNWATCHED_MINUTES="5"
# SANDBOX_PRESSURE_HIGH_IDLE_MINUTES="20"
# SANDBOX_PRESSURE_CRITICAL_PERCENT="90"
# SANDBOX_PRESSURE_CRITICAL_UNWATCHED_MINUTES="2"
# SANDBOX_PRESSURE_CRITICAL_IDLE_MINUTES="10"

# A daily spend limit, in sandbox-hours for the whole account (about $0.13 per hour for our
# template). Once today's total reaches it, new sandboxes are refused until midnight UTC; running
# ones keep working. 0 = off. Logged once a day at the warning share.
# SANDBOX_DAILY_BUDGET_HOURS="50"
# SANDBOX_BUDGET_WARN_PERCENT="80"
# E2B ends a sandbox at the plan's lifetime (60 min on Hobby, 24 h on Pro). This many minutes
# before that, it is saved and replaced with a fresh one; tabs reconnect by themselves.
SANDBOX_RECYCLE_MARGIN_MINUTES="10"

# Minutes a shared document nobody has open stays in memory before it is saved and freed.
DOC_IDLE_CLOSE_MINUTES="5"

# Most entries the file tree is sent per folder; the rest show as "… N more not shown".
FILE_TREE_MAX_ENTRIES="100"

# Largest file (in bytes) the editor will open; bigger files are refused instead of loaded
# into the orchestrator's memory. Default 2 MiB.
EDITOR_MAX_FILE_BYTES="2097152"

# Most autosaves the 30-second sweep runs at once; the rest queue and start as others finish.
SNAPSHOT_CONCURRENCY="10"

# Time spent saving work on shutdown; keep it shorter than the platform's SIGTERM to SIGKILL grace.
SHUTDOWN_SAVE_SECONDS="20"

R2_BUCKET_NAME=""
R2_BUCKET_ENDPOINT=""

R2_TEMPLATE_FOLDER_NAME="templates"
R2_SNAPSHOT_FOLDER_NAME="snapshots"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""