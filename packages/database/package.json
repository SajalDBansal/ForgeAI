{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "prebuild": "bun run db:generate",
    "predev": "bun run db:generate",
    "build": "tsc --noEmit",
    "dev": "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\" && prisma format",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
