# Settings for packages/agent (work plan I4). Later the agent worker (I5) has the same ones.
# Switching provider is a settings change only: provider, key and model ids.

# Which provider pi-ai talks to: openai | anthropic | openrouter | google | groq | ollama | ...
AGENT_PROVIDER=openai
# The key for that provider (OpenAI: platform.openai.com → API keys; Anthropic: platform.claude.com → API Keys;
# OpenRouter: openrouter.ai → Keys).
AGENT_API_KEY=
# Optional: an OpenAI-compatible endpoint for a provider pi-ai doesn't list (e.g. http://localhost:11434/v1 for Ollama).
AGENT_BASE_URL=

# The main model (writes code, uses tools) and the small, fast one (sorting requests, short summaries).
# Cheapest OpenAI pair (2026-10): gpt-5-nano ($0.05/$0.40 per 1M tokens, reasons, tools) and
# gpt-4.1-nano ($0.10/$0.40, no reasoning tokens, quick). Step up the main model to gpt-5-mini when quality matters.
# Claude: claude-opus-5-5 / claude-haiku-4-5-20251001. OpenRouter free: nvidia/nemotron-3-super-120b-a12b:free.
AGENT_MODEL_CODE=gpt-5-nano
AGENT_MODEL_FAST=gpt-4.1-nano
# Optional last try when the main model is rate-limited before it writes anything.
AGENT_MODEL_FALLBACK=

# How hard the main model thinks: off | low | medium | high. Reasoning tokens are billed as output.
AGENT_THINKING=low
