# Postgres connection used by packages/database (Prisma) and the api apps
DATABASE_URL="postgresql://starter:starter@localhost:5432/turbo_starter?schema=public"

# apps/api (Express)
PORT=3001

# apps/api-fast (Fastify) — copy apps/api-fast/.env.example instead of this
# file if you only want that app's PORT (3002).
# PORT=3002

# apps/web
NEXT_PUBLIC_API_HOST="http://localhost:3001"

# docker-compose (packages/database container)
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter
POSTGRES_DB=turbo_starter
